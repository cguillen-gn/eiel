{
  "name": "eiel-login-worker",
  "private": true,
  "version": "1.0.0",
  "description": "Login rápido EIEL (Cloudflare Worker)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "kv:put-credenciales": "wrangler kv key put --binding CREDENTIALS_KV credenciales --path ./credenciales.json"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
