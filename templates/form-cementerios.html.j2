{% extends "base.html.j2" %}

{% block bloque_fase %}Fase {{ fase_actual }}{% endblock %}

{% block title %}EIEL - Cementerios{% endblock %}
{% block header_icon %}<i data-lucide="rose"></i>{% endblock %}
{% block header_title %}CEMENTERIOS{% endblock %}

{% block content %}

{# Estado Vacio #}
{% if cementerios|length == 0 %}
<div class="card empty-state">
    <div class="empty-state-icon">🌹</div>
    <h3 class="empty-state-title">No hay cementerios registrados</h3>
    <p class="empty-state-text">Su municipio no tiene cementerios en la base de datos.</p>
</div>
{% else %}

{# --- SECCIÓN: INSTRUCCIONES --- #}
<div class="card card-info">
    <h4><i data-lucide="info"></i> Instrucciones</h4>
    <ul>
        <li>
            Rellene los datos requeridos y justifique cualquier dato que no disponga o no pueda aportar en el apartado de <strong>Observaciones</strong>.
        </li>
    </ul>
</div>

{# --- SECCIÓN: OCUPACIÓN CEMENTERIOS --- #}
{% for cem in cementerios %}
<div class="card">
    <h2 class="section-title"><i data-lucide="map-pin"></i> {{ cem.nombre }}</h2>
    
    <div class="cementerio-table-wrapper">
        <table class="cementerio-table">
            <thead>
                <tr>
                    <th class="header-ocupacion" colspan="2">OCUPACIÓN</th>
                    <th>FOSAS</th>
                    <th>NICHOS</th>
                    <th>COLUMBARIOS</th>
                    <th>OSARIOS</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="label-cell">OCUPADAS</td>
                    <td class="sublabel-cell"></td> 
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="ocupadas_fosas" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="ocupadas_nichos" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="ocupadas_columbarios" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="ocupadas_osarios" placeholder="0"></td>
                </tr>

                <tr>
                    <td class="label-cell" rowspan="2">LIBRES</td> 
                    <td class="sublabel-cell">EN CONCESIÓN</td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="libres_concesion_fosas" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="libres_concesion_nichos" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="libres_concesion_columbarios" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="libres_concesion_osarios" placeholder="0"></td>
                </tr>

                <tr>
                    <td class="sublabel-cell">
                        PROPIEDAD MUNICIPAL
                        <span class="text-xs">(DISPONIBLES)</span>
                    </td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="libres_municipal_fosas" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="libres_municipal_nichos" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="libres_municipal_columbarios" placeholder="0"></td>
                    <td><input type="number" min="0" data-cem="{{ loop.index }}" data-tipo="libres_municipal_osarios" placeholder="0"></td>
                </tr>

                <tr class="total-row">
                    <td class="label-cell" colspan="2">TOTAL</td> 
                    <td id="total_fosas_{{ loop.index }}">0</td>
                    <td id="total_nichos_{{ loop.index }}">0</td>
                    <td id="total_columbarios_{{ loop.index }}">0</td>
                    <td id="total_osarios_{{ loop.index }}">0</td>
                </tr>
            </tbody>
        </table>
    </div>
    </div>
{% endfor %}

{# --- SECCIÓN: REQUERIMIENTOS --- #}
{% if avisos_personalizados and avisos_personalizados|length > 0 %}
<div class="card card-requerimientos">
    <div class="requerimientos-content">
        <h2 class="section-title">
            <i data-lucide="circle-plus"></i> Otra información solicitada
        </h2>
        
        <p class="form-help form-help-spacer">
            Se ha detectado falta de información o incidencias en la EIEL que requieren solución. Responda a cada punto y adjunte documentación si es necesario.
        </p>

        <ul class="requerimientos-list">
            {% for aviso in avisos_personalizados %}
            {% set req_id = loop.index0 %}
            <li class="aviso-item">
                <div class="requerimiento-header">
                    <div class="requerimiento-mensaje-wrapper">
                        <div class="status-dot {{ 'dot-alta' if aviso.prioridad == 'Alta' else 'dot-media' }}"></div>
                        <span class="requerimiento-mensaje">{{ aviso.mensaje }}</span>
                    </div>
                    
                    {% if aviso.url %}
                        {% set final_url = aviso.url if 'http' in aviso.url else 'https://' ~ aviso.url %}
                        <a href="{{ final_url }}" target="_blank" class="btn btn-secondary btn-sm btn-mapa">
                            <i data-lucide="map" class="icon-sm"></i> Mapa
                        </a>
                    {% endif %}
                </div>
                
                <div class="req-response-box">
                    <textarea class="form-input txt-resp-req req-textarea" data-msg="{{ aviso.mensaje }}" data-id="{{ req_id }}" rows="2"
                              placeholder="Responda o aclare este punto aquí..."></textarea>
                    
                    <div class="req-attach-col">
                        <button type="button" class="btn btn-secondary btn-sm" 
                                onclick="gestionarAdjuntosReq('{{ req_id }}')" 
                                title="Adjuntar documentación">
                            <i data-lucide="paperclip"></i> Adjuntar
                        </button>
                        <div class="file-hint">
                            Máx 35 MB / archivo
                        </div>
                        <div id="lista_adjuntos_req_{{ req_id }}" class="file-list-container file-list-req"></div>
                    </div>
                </div>
            </li>
            {% endfor %}
        </ul>
        <input type="file" id="hiddenInputReq" multiple class="input-file-hidden">
    </div>
</div>
{% endif %}

{# --- SECCIÓN: OBSERVACIONES --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="file-text"></i>Observaciones</h2>
    <div class="form-group">
        <label for="observaciones" class="form-label">Comentarios adicionales:</label>
        <textarea id="observaciones" class="form-input" rows="4" placeholder="Indique aquí cualquier incidencia, aclaración o dato relevante..."></textarea>
    </div>
</div>

{# --- SECCIÓN: ADJUNTOS --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="folder"></i>Documentación Adjunta (Opcional)</h2>    
    <div class="file-upload-area" onclick="document.getElementById('fileInput').click()">
        <div class="upload-icon">
            <i data-lucide="upload-cloud" class="upload-icon-lg"></i>
        </div>
        <div class="upload-title">
            Arrastra y suelta archivos aquí
        </div>
        <div class="upload-subtitle">
            o <span class="upload-link">haz clic para buscarlos</span>
        </div>
        <p class="upload-help">(Planos, fotos, informes, análisis... Máx 35 MB / archivo)</p>
        <input type="file" id="fileInput" multiple class="input-file-hidden">
    </div>
    <div id="fileList" class="file-list-container"></div>
</div>

{# --- SECCIÓN: DATOS DE CONTACTO --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="user"></i>Datos de Contacto</h2>
    
    <div class="grid-2-col">
        <div class="form-group">
            <label class="form-label">Nombre y apellidos *</label>
            <input type="text" id="contactoNombre" class="form-input" placeholder="Ej: Juan Pérez" required>
        </div>
        <div class="form-group">
            <label class="form-label">Departamento</label>
            <input type="text" id="contactoDepartamento" class="form-input" placeholder="Ej: Urbanismo" required>
        </div>
       <div class="form-group">
            <label class="form-label">Email (Para recibir justificante) *</label>
            <input type="email" id="contactoEmail" class="form-input" placeholder="Ej: ejemplo@ayuntamiento.es" required>
        </div>
        
        <div class="form-group">
            <label class="form-label">Confirme su Email *</label>
            <input type="email" id="contactoEmailConfirm" class="form-input" placeholder="Repita el email" required onpaste="return false;">
            </div>
    </div>
</div>

{# --- SECCIÓN: DECLARACIÓN RESPONSABLE --- #}
<div class="card">
    <div class="conformidad-box">
        <label class="check-label">
            <input type="checkbox" id="checkConformidad" class="check-input">
            <span class="check-text">
                <strong>Declaración de veracidad:</strong> Como responsable, 
                confirmo que los datos introducidos son correctos y actualizados.
            </span>
        </label>
    </div>
    
{# --- SECCIÓN: ENVÍO --- #}
    <div id="mensaje" class="message hidden"></div>
    
    <button id="btnEnviar" class="btn btn-primary" disabled>
        Enviar Datos
    </button>
</div>

{% endif %}

{% endblock %}

{% block scripts %}
<script>
document.addEventListener("DOMContentLoaded", () => {
    document.body.classList.add('theme-cementerios');
    if (window.lucide) lucide.createIcons();

    EIEL.applyHeaderTheme('cementerios');
    EIEL.mergeConfig({
        muniCode: "{{ muni_code }}",
        muniName: "{{ muni_display }}",
        fase: "{{ fase_actual }}",
        urlGenerarPdf: "{{ url_generar_pdf }}",
        urlAdjuntos: "{{ url_adjuntos }}",
        urlLogger: "{{ url_logger }}",
        hasAvisos: {{ 'true' if avisos_personalizados and avisos_personalizados|length > 0 else 'false' }},
        yearActual: new Date().getFullYear()
    });

    const cementerios = {{ cementerios_json | safe }};

    function calcularTotales() {
        cementerios.forEach((cem, index) => {
            const cemIndex = index + 1;
            const inputs = document.querySelectorAll(`input[data-cem="${cemIndex}"]`);
            let totales = { fosas: 0, nichos: 0, columbarios: 0, osarios: 0 };
            inputs.forEach(input => {
                const tipo = input.dataset.tipo;
                const valor = parseInt(input.value) || 0;
                if (tipo.includes('fosas')) totales.fosas += valor;
                if (tipo.includes('nichos')) totales.nichos += valor;
                if (tipo.includes('columbarios')) totales.columbarios += valor;
                if (tipo.includes('osarios')) totales.osarios += valor;
            });
            const setTotal = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.textContent = val;
            };
            setTotal(`total_fosas_${cemIndex}`, totales.fosas);
            setTotal(`total_nichos_${cemIndex}`, totales.nichos);
            setTotal(`total_columbarios_${cemIndex}`, totales.columbarios);
            setTotal(`total_osarios_${cemIndex}`, totales.osarios);
        });
    }

    document.addEventListener('input', (e) => {
        if (e.target.type === 'number' && e.target.dataset.cem) {
            calcularTotales();
        }
    });

    const UIProgress = EIEL.UIProgress;
    const archivosMgr = EIEL.createGeneralFileManager();
    const reqMgr = EIEL.createReqAttachmentManager({ variant: 'standard' });
    EIEL.setupConformidad();

    const btnEnviar = document.getElementById("btnEnviar");
    if (!btnEnviar) return;

    btnEnviar.addEventListener("click", async () => {
        const idBatch = EIEL.newBatchId();
        // Paridad cementerios: congela antes de validar y descongela si falla
        formSucio = false;
        toggleFormFreeze(true);
        EIEL.hideMensaje();

        const contact = EIEL.validateContact();
        if (!contact.ok) {
            EIEL.mostrarMensaje(contact.message, "error");
            toggleFormFreeze(false);
            return;
        }

        const oversized = EIEL.findOversizedFile([archivosMgr.getFiles(), reqMgr.getCola()]);
        if (oversized) {
            EIEL.mostrarMensaje(`⚠️ El archivo "${oversized.name}" excede los 35 MB permitidos. Por favor, optimícelo antes de enviar.`, "error");
            toggleFormFreeze(false);
            return;
        }

        const req = EIEL.validateRequerimientos(reqMgr.getCola(), {
            message: "⚠️ Debe dar una respuesta individualizada (texto o adjunto) a cada uno de los requerimientos del apartado «Otra Información Solicitada»."
        });
        if (!req.ok) {
            EIEL.mostrarMensaje(req.message, "error");
            toggleFormFreeze(false);
            return;
        }

        const listaTareas = [
            ...EIEL.buildReqUploadTasks(reqMgr.getCola()),
            ...archivosMgr.getFiles().map(file => ({ file, seccion: 'GENERAL' }))
        ];
        const totalTareas = listaTareas.length;
        UIProgress.show(totalTareas);
        UIProgress.update(0, totalTareas, "Iniciando el envío...");

        try {
            const completados = await EIEL.uploadTaskList(listaTareas, idBatch, { defaultTipo: 'cementerios' });
            UIProgress.update(completados, totalTareas, "Procesando datos y generando justificante...");

            const cementeriosConfig = {{ cementerios_json | safe }};
            const datosCementerios = cementeriosConfig.map((cem, index) => {
                const cemIndex = index + 1;
                const inputs = document.querySelectorAll(`input[data-cem="${cemIndex}"]`);
                let datos = { nombre: cem.nombre };
                inputs.forEach(input => {
                    const tipo = input.dataset.tipo;
                    const val = parseInt(input.value);
                    datos[tipo] = isNaN(val) ? 0 : val;
                });
                return datos;
            });

            const payload = EIEL.buildBasePayload({
                idBatch,
                nombre: contact.nombre,
                email: contact.email,
                departamento: contact.departamento,
                extra: {
                    tipo_formulario: "cementerios",
                    observaciones: document.getElementById("observaciones").value.trim(),
                    archivos_adjuntos: listaTareas.map(t => t.file.name).join("\n"),
                    respuestas_requerimientos_json: JSON.stringify(req.respuestas),
                    cementerios_data: JSON.stringify(datosCementerios)
                }
            });

            await EIEL.sendPdfPayload(payload);
            UIProgress.complete();

            archivosMgr.clear();
            reqMgr.clear();
            EIEL.resetFormAfterSuccess({
                resetSelectIndex: false,
                afterReset: () => { if (typeof calcularTotales === 'function') calcularTotales(); }
            });
        } catch (error) {
            console.error(error);
            EIEL.mostrarMensaje(`❌ Error técnico: ${error.message}`, "error");
            toggleFormFreeze(false);
        }
    });
});
</script>
{% endblock %}
