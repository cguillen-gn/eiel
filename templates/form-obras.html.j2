{% extends "base.html.j2" %}

{% block bloque_fase %}Fase {{ fase_actual }}{% endblock %}

{% block title %}EIEL - Obras{% endblock %}
{% block header_icon %}<i data-lucide="construction"></i>{% endblock %}
{% block header_title %}OBRAS{% endblock %}

{% block content %}

{# --- SECCIÓN: INSTRUCCIONES --- #}
<div class="card card-info">
    <h4><i data-lucide="info"></i> Instrucciones</h4>
    <ul>
        <li><strong>Estado:</strong> Rellene el estado en todas las obras del listado de seguimiento.</li>
        <li><strong>Documentación:</strong> Adjunte el proyecto de cada obra o la documentación disponible. En cualquier caso, deberá aportarse al menos memoria descriptiva y planos que permitan identificar y describir las actuaciones realizadas o previstas. Si no dispone de documentación, justifíquelo en el apartado final de <strong>Observaciones</strong>.</li>
    </ul>
    
</div>

{# --- SECCIÓN: SEGUIMIENTO DE OBRAS --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="list-checks"></i> SEGUIMIENTO DE OBRAS</h2>
    <div class="table-wrapper table-margin-reset">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-w-5 td-ubicacion">Id</th>
                    <th class="col-w-60">Denominación</th>
                    <th class="col-w-20 td-ubicacion">Estado</th>
                    <th class="col-w-15 td-ubicacion">Documentación</th>
                </tr>
            </thead>
            
            <tbody>
                {% for o in obras %}
                {% set codigo_obra = o.clave ~ o.mun ~ o.orden %}
                <tr class="fila-obra">
                    
                    <td class="td-ubicacion text-xs td-code">
                        {{ codigo_obra[-3:] }}
                    </td>

                    <td>
                        <div class="obra-column-container">
                        <div class="item-title-row">
                            <span class="item-title">{{ o.nombre }}</span>
                            {% if o.link_licitacion %}
                                {% set url_lic = o.link_licitacion if 'http' in o.link_licitacion else 'https://' ~ o.link_licitacion %}
                                <a href="{{ url_lic }}"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn-licitacion"
                                   title="Ver licitación"
                                   aria-label="Ver licitación">
                                    <i data-lucide="external-link" class="icon-sm"></i>
                                </a>
                            {% endif %}
                        </div>

                        {% if o.plan_obra and "licitaciones" not in o.plan_obra|lower and "contratos menores" not in o.plan_obra|lower %}
                            <div class="obra-details-row">
                                <span class="subvencion-badge">SUBVENCIÓN</span>
                                {# Forzamos el tamaño y color aquí para que vuelva a su estado original #}
                                <span class="header-plan header-plan-muted">
                                    {{ o.plan_obra }}
                                </span>
                            </div>
                        {% endif %}
                    </div>
                    </td>
                  
                    <td class="td-ubicacion">
                        {% set estado_inicial = "Finalizada" if o.cond == 2 else ("No iniciada" if o.cond == 1 else "") %}
                        <div class="estado-obra-wrap">
                            <select class="form-select select-estado" 
                                data-obra-id="{{ codigo_obra }}"
                                data-clave="{{ o.clave }}"
                                data-orden="{{ o.orden }}"
                                data-nombre="{{ o.nombre }}" 
                                data-plan="{{ o.plan_obra }}"
                                data-original="{{ estado_inicial }}"
                                data-requiere-doc="{{ 'false' if o.proyecto == 'RE' else 'true' }}">
                                
                                <option value="" {% if o.cond == 0 %}selected{% endif %}>Seleccionar...</option>
                                <option value="No iniciada">No iniciada</option>
                                <option value="En ejecución">En ejecución</option>
                                <option value="Paralizada">Paralizada</option>
                                <option value="Finalizada" {% if o.cond == 2 %}selected{% endif %}>Finalizada</option>
                                <option value="Desconocido">Desconocido / Sin datos</option>
                                <option value="Otro dpto. Ayto.">Gestiona otro dpto. Ayto.</option>
                            </select>
                            <div class="contacto-dpto-wrap" hidden>
                                <label class="contacto-dpto-label" for="contacto_dpto_{{ codigo_obra }}">¿Con quién contactar?</label>
                                <input type="text"
                                       id="contacto_dpto_{{ codigo_obra }}"
                                       class="form-input input-contacto-dpto"
                                       maxlength="200"
                                       placeholder="Ej: Urbanismo, María López"
                                       autocomplete="off">
                            </div>
                        </div>
                    </td>

                    <td class="td-ubicacion">
                        {% if o.proyecto == 'RE' %}
                            <div class="form-help form-help-sm">
                            No requiere documentación
                            </div>
                        {% else %}
                            <button type="button" class="btn btn-secondary btn-sm" 
                                    onclick="gestionarAdjuntos('{{ codigo_obra }}')"
                                    title="Adjuntar documentación">
                                <i data-lucide="paperclip"></i> Adjuntar
                            </button>
                            <div class="file-hint file-hint--mt-4">
                                Máx 35 MB / archivo
                            </div>
                            <div id="lista_adjuntos_{{ codigo_obra }}" class="file-list-container file-list-mt-5"></div>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# --- SECCIÓN: OTRAS OBRAS --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="list-plus"></i> OTRAS OBRAS DETECTADAS</h2>
    <div class="card-body">
        <p class="form-help form-help--mb">
            Añada filas para registrar obras <strong>ejecutadas o a ejecutar por el ayuntamiento</strong> que no figuran en el listado superior.
        </p>

        <div class="table-wrapper table-wrapper--card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="col-w-37">Denominación de la Obra</th>
                        <th class="col-w-20">Estado</th>
                        <th class="col-w-20">Observaciones</th>
                        <th class="col-w-18 th-center">Documentación</th>
                        <th class="col-w-5 th-center"></th> 
                    </tr>
                </thead>
                <tbody id="bodyNuevasObras"></tbody>
            </table>
        </div>

        <div class="mt-1rem">
            <button type="button" class="btn btn-secondary btn-sm btn-secondary--white" onclick="agregarFilaNuevaObra()">
                <i data-lucide="plus"></i> Añadir otra obra
            </button>
        </div>
    </div>
</div>

{# --- SECCIÓN: REQUERIMIENTOS --- #}
{% if avisos_personalizados and avisos_personalizados|length > 0 %}
<div class="card card-requerimientos">
    <div class="requerimientos-content">
        <h2 class="section-title">
            <i data-lucide="circle-plus"></i> Otra información solicitada
        </h2>
        
        <p class="form-help form-help-spacer">
            Se ha detectado falta de información o incidencias en la EIEL que requieren solución. Responda a cada punto y adjunte documentación si es necesario.
        </p>

        <ul class="requerimientos-list">
            {% for aviso in avisos_personalizados %}
            {% set req_id = loop.index0 %}
            <li class="aviso-item aviso-item--gap-12">
                
                {# 1. Cabecera: Mensaje y Botón Mapa #}
                <div class="requerimiento-header requerimiento-header--mb">
                    <div class="requerimiento-mensaje-wrapper">
                        <div class="status-dot {{ 'dot-alta' if aviso.prioridad == 'Alta' else 'dot-media' }}"></div>
                        <span class="requerimiento-mensaje">{{ aviso.mensaje }}</span>
                    </div>
                    
                    {% if aviso.url %}
                        {% set final_url = aviso.url if 'http' in aviso.url else 'https://' ~ aviso.url %}
                        <a href="{{ final_url }}" target="_blank" class="btn btn-secondary btn-sm btn-mapa">
                            <i data-lucide="map" class="icon-sm"></i> Mapa
                        </a>
                    {% endif %}
                </div>
                
                {# 2. Contenedor de Respuesta y Adjuntos #}
                <div class="req-response-box">
                    
                    {# Cuadro de texto para la respuesta #}
                    <textarea class="form-input txt-resp-req req-textarea--obras" 
                              data-msg="{{ aviso.mensaje }}" 
                              data-id="{{ req_id }}" 
                              rows="2" 
                              placeholder="Responda o aclare este punto aquí..."></textarea>
                    
                    {# Grupo de Botón + Aviso de tamaño + Lista de archivos #}
                    <div class="req-attach-col">
                        <div>
                            <button type="button" class="btn btn-secondary btn-sm" 
                                    onclick="gestionarAdjuntosReq('{{ req_id }}')"
                                    title="Adjuntar documentación">
                                <i data-lucide="paperclip"></i> Adjuntar
                            </button>
                            <div class="file-hint file-hint--mt-4">
                                Máx 35 MB / archivo
                            </div>
                        </div>
                        
                        {# Contenedor de la lista de archivos adjuntos #}
                        <div id="lista_adjuntos_req_{{ req_id }}" class="file-list-container file-list-req"></div>
                    </div>
                </div>
            </li>
            {% endfor %}
        </ul>
        <input type="file" id="hiddenInputReq" multiple class="input-file-hidden">
    </div>
</div>
{% endif %}

{# --- SECCIÓN: OBSERVACIONES --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="file-text"></i>Observaciones</h2>
    <div class="form-group">
        <label for="observaciones" class="form-label">Comentarios adicionales:</label>
        <textarea id="observaciones" class="form-input textarea-inherit" rows="4" placeholder="Indique aquí cualquier incidencia, aclaración o dato relevante..."></textarea>
    </div>
</div>

{# --- SECCIÓN: DATOS DE CONTACTO --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="user"></i>Datos de Contacto</h2>
    <div class="grid-2-col">
        <div class="form-group">
            <label class="form-label">Nombre y apellidos *</label>
            <input type="text" id="contactoNombre" class="form-input" placeholder="Ej: Juan Pérez" required>
        </div>
        <div class="form-group">
            <label class="form-label">Departamento</label>
            <input type="text" id="contactoDepartamento" class="form-input" placeholder="Ej: Urbanismo" required>
        </div>
        <div class="form-group">
        <label class="form-label">Email (Para recibir justificante) *</label>
        <input type="email" id="contactoEmail" class="form-input" placeholder="Ej: ejemplo@ayuntamiento.es" required>
    </div>

    <div class="form-group">
        <label class="form-label">Confirme su Email *</label>
        <input type="email" id="contactoEmailConfirm" class="form-input" placeholder="Repita el email" required onpaste="return false;">
    </div>
    </div>
</div>

{# --- SECCIÓN: DECLARACIÓN RESPONSABLE --- #}
<div class="card">
    <div class="conformidad-box">
        <label class="check-label">
            <input type="checkbox" id="checkConformidad" class="check-input">
            <span class="check-text">
                <strong>Declaración de veracidad:</strong> Como responsable, 
                confirmo que los datos introducidos son correctos y actualizados.
            </span>
        </label>
    </div>

    
{# --- SECCIÓN: ENVÍO --- #}

<div id="mensaje" class="message hidden"></div>
    <button id="btnEnviar" class="btn btn-primary btn-obras" disabled>
        Enviar Datos
    </button>
</div>

<input type="file" id="hiddenFileInput" multiple class="input-file-hidden">

{% endblock %}

{% block scripts %}
<script>
document.addEventListener("DOMContentLoaded", () => {
    document.body.classList.add('theme-obras');
    if (window.lucide) lucide.createIcons();

    EIEL.applyHeaderTheme('obras');

    const ESTADO_OTRO_DPTO = "Otro dpto. Ayto.";

    function syncContactoDpto(select) {
        const wrap = select.closest(".estado-obra-wrap");
        const box = wrap && wrap.querySelector(".contacto-dpto-wrap");
        const input = box && box.querySelector(".input-contacto-dpto");
        if (!box || !input) return;
        const show = select.value === ESTADO_OTRO_DPTO;
        box.hidden = !show;
        if (!show) input.value = "";
    }

    document.querySelectorAll('.select-estado').forEach(select => {
        if (select.value !== "") select.classList.add('has-value');
        syncContactoDpto(select);
        select.addEventListener('change', function() {
            if (this.value !== "") this.classList.add('has-value');
            else this.classList.remove('has-value');
            syncContactoDpto(this);
        });
    });

    EIEL.mergeConfig({
        muniCode: "{{ muni_code }}",
        muniName: "{{ muni_display }}",
        fase: "{{ fase_actual }}",
        urlGenerarPdf: "{{ url_generar_pdf }}",
        urlAdjuntos: "{{ url_adjuntos }}",
        urlLogger: "{{ url_logger }}",
        hasAvisos: {{ 'true' if avisos_personalizados and avisos_personalizados|length > 0 else 'false' }},
        yearActual: new Date().getFullYear()
    });

    const handleSelectColor = (el) => {
        if (!el) return;
        if (el.value === "") el.classList.remove('has-value');
        else el.classList.add('has-value');
    };
    document.querySelectorAll('.form-select').forEach(select => {
        handleSelectColor(select);
        select.addEventListener('change', () => handleSelectColor(select));
    });

    const UIProgress = EIEL.UIProgress;

    let colaAdjuntos = {};
    let idObraActual = null;
    const inputObras = document.getElementById('hiddenFileInput');

    window.gestionarAdjuntos = (id) => {
        idObraActual = id;
        if (inputObras) inputObras.click();
    };

    if (inputObras) {
        inputObras.addEventListener('change', () => {
            formSucio = true;
            const files = Array.from(inputObras.files);
            if (!files.length || !idObraActual) return;
            const validos = EIEL.filterFilesBySize(files);
            if (validos.length > 0) {
                if (!colaAdjuntos[idObraActual]) colaAdjuntos[idObraActual] = [];
                colaAdjuntos[idObraActual].push(...validos);
                renderAdjuntos(idObraActual);
            }
            inputObras.value = "";
            idObraActual = null;
        });
    }

    function renderAdjuntos(id) {
        const contenedor = document.getElementById(`lista_adjuntos_${id}`);
        if (!contenedor) return;
        contenedor.innerHTML = (colaAdjuntos[id] || []).map((f, i) => `
            <div class="file-item file-item--micro">
                <span title="${f.name}">📄 ${f.name.substring(0,12)}...</span>
                <button type="button" onclick="eliminarArchivo('${id}', ${i})" class="btn-danger-icon"><i data-lucide="trash-2" class="icon-trash-sm"></i></button>
            </div>
        `).join("");
        if (window.lucide) lucide.createIcons();
    }

    window.eliminarArchivo = (id, index) => {
        formSucio = true;
        colaAdjuntos[id].splice(index, 1);
        renderAdjuntos(id);
    };

    let contadorNuevas = 0;
    window.agregarFilaNuevaObra = () => {
        formSucio = true;
        contadorNuevas++;
        const idTemp = `NUEVA_OBRA_${contadorNuevas}`;
        const tbody = document.getElementById('bodyNuevasObras');
        if (!tbody) return;

        const tr = document.createElement('tr');
        tr.id = `fila_${idTemp}`;
        tr.className = 'fila-nueva-obra';
        tr.innerHTML = `
            <td class="td-top">
                <input type="text" class="form-input input-nueva-nombre" data-temp-id="${idTemp}" placeholder="Ej: Urbanización C/La Paz">
            </td>
            <td class="td-top">
                <select class="form-select input-nueva-estado">
                    <option value="">Seleccionar...</option>
                    <option value="No iniciada">No iniciada</option>
                    <option value="En ejecución">En ejecución</option>
                    <option value="Paralizada">Paralizada</option>
                    <option value="Finalizada">Finalizada</option>
                </select>
            </td>
            <td class="td-top">
                <textarea class="form-input input-nueva-obs textarea-nueva-obra" rows="1" placeholder="..."></textarea>
            </td>
            <td class="td-top-center">
                <button type="button" class="btn btn-secondary btn-sm" onclick="gestionarAdjuntos('${idTemp}')" title="Adjuntar documentación">
                    <i data-lucide="paperclip"></i> Adjuntar
                </button>
                <div class="file-hint file-hint--mt-4">Máx 35 MB / archivo</div>
                <div id="lista_adjuntos_${idTemp}" class="file-list-container file-list-mt-8"></div>
            </td>
            <td class="td-top-center">
                <button type="button" class="btn-danger-icon" onclick="eliminarFilaNuevaObra('${idTemp}')" title="Eliminar fila">
                    <i data-lucide="trash-2" class="icon-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);

        const nuevoSelect = tr.querySelector('.input-nueva-estado');
        if (nuevoSelect) {
            handleSelectColor(nuevoSelect);
            nuevoSelect.addEventListener('change', () => handleSelectColor(nuevoSelect));
        }
        if (window.lucide) lucide.createIcons();
    };

    window.eliminarFilaNuevaObra = (idFila) => {
        formSucio = true;
        const fila = document.getElementById(`fila_${idFila}`);
        if (fila) {
            fila.remove();
            if (typeof colaAdjuntos !== 'undefined' && colaAdjuntos[idFila]) {
                delete colaAdjuntos[idFila];
            }
        }
    };

    agregarFilaNuevaObra();

    const reqMgr = EIEL.createReqAttachmentManager({ variant: 'obras' });
    EIEL.setupConformidad();

    const btnEnviar = document.getElementById("btnEnviar");
    if (!btnEnviar) return;

    btnEnviar.addEventListener("click", async () => {
        const idBatch = EIEL.newBatchId();
        EIEL.hideMensaje();

        const contact = EIEL.validateContact();
        if (!contact.ok) { EIEL.mostrarMensaje(contact.message, "error"); return; }

        const oversized = EIEL.findOversizedFile([colaAdjuntos, reqMgr.getCola()]);
        if (oversized) {
            EIEL.mostrarMensaje(`⚠️ El archivo "${oversized.name}" excede los 35 MB permitidos. Por favor, optimícelo antes de enviar.`, "error");
            return;
        }

        const req = EIEL.validateRequerimientos(reqMgr.getCola(), {
            message: "⚠️ Debe dar una respuesta individualizada (texto o adjunto) a cada uno de los requerimientos del apartado «Otra Información Solicitada»."
        });
        if (!req.ok) { EIEL.mostrarMensaje(req.message, "error"); return; }

        const selects = document.querySelectorAll('.fila-obra .select-estado');
        let obrasSinEstado = false;
        let obrasSinContactoDpto = false;
        selects.forEach(s => {
            if (!s.value) obrasSinEstado = true;
            if (s.value === ESTADO_OTRO_DPTO) {
                const wrap = s.closest(".estado-obra-wrap");
                const input = wrap && wrap.querySelector(".input-contacto-dpto");
                if (!input || !input.value.trim()) obrasSinContactoDpto = true;
            }
        });
        if (obrasSinEstado) {
            EIEL.mostrarMensaje("⚠️ Por favor, indique el estado de todas las obras del listado principal (puede marcar 'Desconocido').", "error");
            return;
        }
        if (obrasSinContactoDpto) {
            EIEL.mostrarMensaje("⚠️ En las obras de «Gestiona otro dpto. Ayto.» indique con quién contactar para obtener la información.", "error");
            return;
        }

        formSucio = false;
        toggleFormFreeze(true);

        const listaTareas = [];
        Object.entries(colaAdjuntos).forEach(([id, listado]) => {
            listado.forEach(file => listaTareas.push({ file, seccion: id, tipo: 'obras' }));
        });
        Object.entries(reqMgr.getCola()).forEach(([id, listado]) => {
            const numReq = parseInt(id, 10) + 1;
            listado.forEach(file => listaTareas.push({ file, seccion: `REQUERIMIENTO_${numReq}`, tipo: 'requerimientos' }));
        });

        const totalTareas = listaTareas.length;
        UIProgress.show(totalTareas);

        try {
            const completados = await EIEL.uploadTaskList(listaTareas, idBatch, {
                retries: 2,
                throwOnFail: true
            });

            const selectsEstado = document.querySelectorAll('.fila-obra .select-estado');
            const estadosObras = Array.from(selectsEstado).map(select => {
                const wrap = select.closest(".estado-obra-wrap");
                const inputContacto = wrap && wrap.querySelector(".input-contacto-dpto");
                const contactoDpto =
                    select.value === ESTADO_OTRO_DPTO && inputContacto
                        ? inputContacto.value.trim()
                        : "";
                return {
                    obra: select.dataset.obraId,
                    clave: select.dataset.clave,
                    orden: select.dataset.orden,
                    nombre: select.dataset.nombre,
                    plan: select.dataset.plan,
                    estado: select.value,
                    contacto_dpto: contactoDpto,
                    modificado: select.value !== select.dataset.original,
                    archivos: (colaAdjuntos[select.dataset.obraId] || []).map(f => f.name).join("; ")
                };
            });

            const nuevasObrasData = [];
            document.querySelectorAll(".fila-nueva-obra").forEach(fila => {
                const inputN = fila.querySelector(".input-nueva-nombre");
                const inputO = fila.querySelector(".input-nueva-obs");
                const inputE = fila.querySelector(".input-nueva-estado");
                if (inputN && inputN.value.trim()) {
                    const idT = inputN.dataset.tempId;
                    nuevasObrasData.push({
                        nombre: inputN.value.trim(),
                        estado: inputE ? inputE.value : "",
                        observaciones: inputO ? inputO.value.trim() : "",
                        archivos: (colaAdjuntos[idT] || []).map(f => f.name).join("; ")
                    });
                }
            });

            UIProgress.update(completados, totalTareas, "Procesando datos y generando justificante...");

            const payload = EIEL.buildBasePayload({
                idBatch,
                nombre: contact.nombre,
                email: contact.email,
                departamento: contact.departamento,
                extra: {
                    tipo_formulario: "obras",
                    observaciones: document.getElementById("observaciones").value.trim(),
                    datos_obras_json: JSON.stringify(estadosObras),
                    otras_obras_json: JSON.stringify(nuevasObrasData),
                    respuestas_requerimientos_json: JSON.stringify(req.respuestas),
                    archivos_adjuntos: listaTareas.map(t => t.file.name).join("\n")
                }
            });

            await EIEL.sendPdfPayload(payload);
            UIProgress.complete();

            colaAdjuntos = {};
            reqMgr.clear();
            EIEL.resetFormAfterSuccess();
        } catch (error) {
            console.error(error);
            EIEL.mostrarMensaje(EIEL.formatUserError(error), "error");
            toggleFormFreeze(false);
        }
    });
});
</script>
{% endblock %}
