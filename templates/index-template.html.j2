<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico">
    <title>EIEL {{ fase_actual }} - Acceso</title>
    <link rel="stylesheet" href="css/style.css?v=20260806a"> 
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
<div class="panel">
    <div class="panel-header" id="mainHeader">
        <h1>EIEL {{ fase_actual }}</h1>
        <p id="headerSubtitle" class="header-subtitle">Portal de Recogida de Datos</p>
        
        <div id="headerMuniInfo" class="header-muni-info">
            <span id="headerMuniName" class="header-muni-name">Nombre del Municipio</span>
            <span id="headerCode" class="header-code-label">000</span>
        </div>
    </div>

    <div id="viewLogin" class="form-section">
        <label class="login-label">1. Municipio</label>
        <select id="muniSelect" class="input-field">
            <option value="">Seleccionar...</option>
        </select>

        <label class="login-label">2. Código de Acceso</label>
        <input type="password" id="muniCode" class="input-field" placeholder="Introduzca el código facilitado">

        <button id="btnLogin" class="btn-entrar">Entrar</button>
        <p id="errorMsg" class="error-msg">Código incorrecto</p>
    </div>

    <div id="viewMenu" class="form-section hidden">
        <div class="btn-grid">
            <a id="lnkObras" href="#" class="btn-menu b-obras">
                <i data-lucide="construction" class="btn-icon"></i>
                <span class="btn-menu-body"><span class="btn-menu-label">Obras</span></span>
            </a>
            <a id="lnkEquipamientos" href="#" class="btn-menu b-equipamientos">
                <i data-lucide="building-2" class="btn-icon"></i>
                <span class="btn-menu-body"><span class="btn-menu-label">Equipamientos</span></span>
            </a>
            <a id="lnkCementerios" href="#" class="btn-menu b-cementerios hidden">
                <i data-lucide="rose" class="btn-icon"></i>
                <span class="btn-menu-body"><span class="btn-menu-label">Cementerios</span></span>
            </a>
            <a id="lnkResiduos" href="#" class="btn-menu b-residuos">
                <i data-lucide="recycle" class="btn-icon"></i>
                <span class="btn-menu-body"><span class="btn-menu-label">Residuos</span></span>
            </a>
            <a id="lnkAgua" href="#" class="btn-menu b-agua">
                <i data-lucide="droplet" class="btn-icon"></i>
                <span class="btn-menu-body"><span class="btn-menu-label">Abastecimiento de agua</span></span>
            </a>
            <a id="lnkSaneamiento" href="#" class="btn-menu b-saneamiento hidden">
                <i data-lucide="test-tube" class="btn-icon"></i>
                <span class="btn-menu-body"><span class="btn-menu-label">Saneamiento y depuración</span></span>
            </a>
            <a id="lnkAlumbrado" href="#" class="btn-menu b-alumbrado hidden">
                <i data-lucide="lightbulb" class="btn-icon"></i>
                <span class="btn-menu-body"><span class="btn-menu-label">Alumbrado Público</span></span>
            </a>
            <a id="lnkViario" href="#" class="btn-menu b-viario hidden">
                <i data-lucide="milestone" class="btn-icon"></i>
                <span class="btn-menu-body"><span class="btn-menu-label">Viario</span></span>
            </a>
        </div>

        <div class="logout-wrap">
            <button onclick="logout()" class="logout-btn">
                Cerrar Sesión
            </button>
        </div>
    </div>
</div>

<footer class="login-footer">
    <p>Gestionado por:</p>
    <div class="contenedor-logos">
        <a href="https://www.diputacionalicante.es" target="_blank"><img src="img/logo_dipu.gif" alt="Diputación" class="logo-img"></a>
        <a href="https://www.geonet.es" target="_blank"><img src="img/logo_geonet.png" alt="GeoNet" class="logo-img"></a>
    </div>
    <p class="copyright">© 2026 Web desarrollada por Geonet Territorial SAU</p>
</footer>

<script>
    /**
     * [1] ESTADO Y CONFIGURACIÓN INICIAL
     * Datos inyectados desde el servidor vía Jinja2.
     */
    const MUNICIPIOS = {{ municipios_lista | safe }}; 
    const URL_LOGIN_API = "{{ url_login_api }}";
    const URL_LOGGER = "{{ url_logger }}";
    const FASE_ACTUAL = "{{ fase_actual }}";
    const MUNICIPIOS_FLAGS = {{ config_flags_json | safe }};
    /** Experimento UX: estados desde logs_envios. Poner false para desactivar. */
    const MENU_ESTADOS_ENVIO = true;

    /**
     * [2] MAPEO DE ELEMENTOS DEL DOM
     * Referencias centralizadas para evitar consultas repetitivas.
     */
    const ui = {
        login: document.getElementById('viewLogin'),
        menu: document.getElementById('viewMenu'),
        select: document.getElementById('muniSelect'),
        input: document.getElementById('muniCode'),
        btn: document.getElementById('btnLogin'),
        error: document.getElementById('errorMsg'),
        muniInfo: document.getElementById('headerMuniInfo'),
        headerBadge: document.getElementById('headerCode'),
        headerName: document.getElementById('headerMuniName'),
        links: {
            agua: document.getElementById('lnkAgua'),
            obras: document.getElementById('lnkObras'),
            residuos: document.getElementById('lnkResiduos'),
            cementerios: document.getElementById('lnkCementerios'),
            equipamientos: document.getElementById('lnkEquipamientos'),
            alumbrado: document.getElementById('lnkAlumbrado'),
            viario: document.getElementById('lnkViario'),
            saneamiento: document.getElementById('lnkSaneamiento')
        }
    };

    /**
     * [3] GESTIÓN DE SESIÓN Y PERSISTENCIA
     * Funciones para controlar el estado de acceso del usuario.
     */
    window.logout = function() {
        localStorage.clear(); 
        document.getElementById('mainHeader').classList.remove('header-expanded');
        window.location.reload();
    }

    /**
     * Verifica si ya hay una sesión activa al cargar la página.
     */
    function checkSession() {
        const code = localStorage.getItem("eiel_muni_code");
        const name = localStorage.getItem("eiel_muni_name");
        const isTest = localStorage.getItem("eiel_is_test") === "true";

        if (code && name) {
            loginSuccess(code, name, isTest);
        }
    }


    MUNICIPIOS.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.code;
        opt.textContent = `${m.name} (${m.code})`; 
        ui.select.appendChild(opt);
    });

    /**
     * [4] LÓGICA DE NEGOCIO Y COMUNICACIÓN (API)
     * Login simple (sin token de sesión ni warmup). Tokens desactivados
     * temporalmente para recuperar la velocidad/fiabilidad de Apps Script.
     */
    ui.btn.addEventListener('click', async () => {
        const selectedCode = ui.select.value;
        const enteredPass = ui.input.value.trim();

        if(!selectedCode || !enteredPass) {
            showError("Seleccione un municipio e introduzca el código.");
            return;
        }

        ui.btn.disabled = true; 
        ui.btn.textContent = "Verificando..."; 
        ui.error.style.display = 'none';

        try {
            const response = await fetch(URL_LOGIN_API, {
                method: "POST",
                headers: { "Content-Type": "text/plain;charset=utf-8" },
                body: JSON.stringify({ codigo: selectedCode, password: enteredPass })
            });
            const data = await response.json();

            if (data.success === false) {
                showError("Error de Servidor: " + data.message); 
                return;
            }

            if (data.valid === true) {
                const muniLocal = MUNICIPIOS.find(m => m.code === selectedCode);
                const nombreParaGuardar = muniLocal
                    ? (muniLocal.name_bonito || muniLocal.name)
                    : (data.nombre || selectedCode);

                // Limpiar token antiguo si existía (ya no se usa)
                localStorage.removeItem("eiel_session_token");

                loginSuccess(selectedCode, nombreParaGuardar, data.isTest || false);
            } else {
                showError("Código de acceso incorrecto.");
            }
        } catch (error) {
            console.error(error); 
            showError("Error de conexión con el servidor.");
        } finally {
            ui.btn.disabled = false; 
            ui.btn.textContent = "Entrar";
        }
    });

    /**
     * [5] RENDERIZADO Y MANIPULACIÓN DE UI
     * Funciones que actualizan visualmente el portal tras el login.
     */
    function loginSuccess(code, name, isTest = false) {
        let displayName = name;
        if (isTest && !name.startsWith("(PRUEBAS) ")) {
            displayName = "(PRUEBAS) " + name;
        }
        
        document.getElementById('mainHeader').classList.add('header-expanded'); 
        localStorage.setItem("eiel_muni_code", code);
        localStorage.setItem("eiel_muni_name", displayName);
        localStorage.setItem("eiel_is_test", isTest);

        ui.muniInfo.style.display = 'flex'; 
        ui.headerBadge.textContent = `(Cód. ${code})`;    
      
        if (displayName.includes(" / ")) {
            ui.headerName.innerHTML = displayName.replace(" / ", "<br>"); 
        } else {
            ui.headerName.textContent = displayName;
        }
        
        ui.links.agua.href = `agua_${code}.html`;
        ui.links.obras.href = `obras_${code}.html`;
        ui.links.residuos.href = `residuos_${code}.html`;
        ui.links.cementerios.href = `cementerios_${code}.html`;
        ui.links.equipamientos.href = `equipamientos_${code}.html`;

        const flags = MUNICIPIOS_FLAGS[code] || { alumbrado: false, viario: false, saneamiento: false, cementerios: false };
        
        ui.links.alumbrado.href = `alumbrado_${code}.html`;
        ui.links.alumbrado.classList.toggle('hidden', !flags.alumbrado);
        
        ui.links.viario.href = `viario_${code}.html`;
        ui.links.viario.classList.toggle('hidden', !flags.viario);
        
        ui.links.saneamiento.href = `saneamiento_${code}.html`;
        ui.links.saneamiento.classList.toggle('hidden', !flags.saneamiento);
        
        ui.links.cementerios.classList.toggle('hidden', !flags.cementerios);

        ui.login.classList.add('hidden');
        ui.menu.classList.remove('hidden');
        ui.error.style.display = 'none';

        loadEstadosEnvio(code, isTest);
    }

    function formatFechaCorta(iso) {
        if (!iso) return "";
        const d = new Date(iso);
        if (isNaN(d.getTime())) return "";
        return d.toLocaleDateString("es-ES", { day: "numeric", month: "short" })
            .replace(".", "");
    }

    function clearMenuEstados() {
        Object.values(ui.links).forEach((link) => {
            if (!link) return;
            link.classList.remove("btn-menu--enviado");
            const body = link.querySelector(".btn-menu-body");
            if (!body) return;
            const st = body.querySelector(".btn-menu-status");
            if (st) st.remove();
        });
    }

    function applyMenuEstados(envios) {
        clearMenuEstados();
        if (!envios) return;
        Object.keys(ui.links).forEach((tipo) => {
            const link = ui.links[tipo];
            const info = envios[tipo];
            if (!link || !info || !info.fecha) return;
            const body = link.querySelector(".btn-menu-body");
            if (!body) return;
            const fechaCorta = formatFechaCorta(info.fecha);
            const texto = fechaCorta
                ? `Enviado (${fechaCorta}) · pendiente revisar por Geonet`
                : "Enviado · pendiente revisar por Geonet";
            let st = body.querySelector(".btn-menu-status");
            if (!st) {
                st = document.createElement("span");
                st.className = "btn-menu-status";
                body.appendChild(st);
            }
            st.textContent = texto;
            link.classList.add("btn-menu--enviado");
        });
    }

    /**
     * Consulta logs_envios vía Logger (sin regenerar HTML).
     * Si falla (cold start, script antiguo…), el menú queda como siempre.
     */
    async function loadEstadosEnvio(code, isTest) {
        if (!MENU_ESTADOS_ENVIO || !URL_LOGGER || URL_LOGGER.indexOf("http") !== 0) {
            return;
        }
        clearMenuEstados();
        const cacheKey = `eiel_estados_${FASE_ACTUAL}_${code}_${isTest ? "t" : "r"}`;
        try {
            const cached = sessionStorage.getItem(cacheKey);
            if (cached) {
                const parsed = JSON.parse(cached);
                if (parsed && parsed.ts && Date.now() - parsed.ts < 120000 && parsed.envios) {
                    applyMenuEstados(parsed.envios);
                }
            }
        } catch (e) { /* ignore */ }

        const qs = new URLSearchParams({
            action: "estados_envio",
            codigo: code,
            fase: String(FASE_ACTUAL),
            incluir_test: isTest ? "1" : "0"
        });
        try {
            const res = await fetch(`${URL_LOGGER}?${qs.toString()}`);
            const text = await res.text();
            let data;
            try {
                data = JSON.parse(text);
            } catch (parseErr) {
                console.warn("Estados envío: respuesta no JSON (¿Logger sin redesplegar?)", text.slice(0, 120));
                return;
            }
            if (!data || data.status !== "success" || !data.envios) {
                console.warn("Estados envío:", data && data.message ? data.message : data);
                return;
            }
            applyMenuEstados(data.envios);
            try {
                sessionStorage.setItem(cacheKey, JSON.stringify({ ts: Date.now(), envios: data.envios }));
            } catch (e2) { /* ignore */ }
        } catch (err) {
            console.warn("Estados envío: no disponibles", err);
        }
    }

    function showError(msg) {
        ui.error.textContent = msg;
        ui.error.style.display = 'block';
    }

    /**
     * [6] INICIALIZACIÓN DEL CICLO DE VIDA (Lifecycle)
     * Ejecución tras la carga completa del documento.
     */
    document.addEventListener('DOMContentLoaded', () => {
        // Inicializar iconos de Lucide
        if (window.lucide) {
            lucide.createIcons();
        }
        
        if (!localStorage.getItem("eiel_muni_code")) {
            localStorage.clear();
        }
        checkSession();
    });
</script>
</body>
</html>