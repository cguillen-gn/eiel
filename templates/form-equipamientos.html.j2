{% extends "base.html.j2" %}

{% block bloque_fase %}Fase {{ fase_actual }}{% endblock %}

{% block title %}EIEL - Equipamientos{% endblock %}
{% block header_icon %}<i data-lucide="building-2"></i>{% endblock %}
{% block header_title %}EQUIPAMIENTOS{% endblock %}

{% block content %}

{# --- SECCIÓN: INSTRUCCIONES --- #}
<div class="card card-info">
    <h4><i data-lucide="info"></i> Instrucciones</h4>
    <ul>
        Despliegue cada temática para ver los equipamientos disponibles en la EIEL. Pulse en el botón de Mapa para ver el equipamiento en un visor.
        <li><strong>Estado: </strong>Seleccione el estado de conservación en el que se encuentra cada equipamiento. Por defecto se muestra el último estado disponible en la EIEL.</li>
        <li><strong>Observaciones: </strong>Añada cualquier observación que pueda ser de interés para algún equipamiento como <strong>cambio de nombre</strong>, <strong>cambio de uso</strong> o si <strong>deja de prestar servicio</strong> temporal o definitivamente.</li>

    </ul>
</div>

{# --- SECCIÓN: EQUIPAMIENTOS GENERALES --- #}
{% set orden_categorias = ['CASA CONSISTORIAL', 'CENTRO CULTURAL', 'CENTRO ENSEÑANZA', 'CENTRO SANITARIO','CENTRO ASISTENCIAL', 'MERCADO/LONJA','PROTECCIÓN CIVIL', 'TANATORIO', 'INSTALACIÓN DEPORTIVA', 'PARQUE'] %}

{# DEFINIR ICONOS POR CATEGORÍA #}
{% set iconos_cat = {
    'CASA CONSISTORIAL': 'landmark',
    'CENTRO CULTURAL': 'clapperboard',
    'CENTRO ENSEÑANZA': 'graduation-cap',
    'CENTRO SANITARIO': 'hospital',
    'CENTRO ASISTENCIAL': 'accessibility',
    'MERCADO/LONJA': 'shopping-basket',
    'PROTECCIÓN CIVIL': 'shield-alert',
    'TANATORIO': 'house-heart',
    'INSTALACIÓN DEPORTIVA': 'volleyball',
    'PARQUE': 'tree-pine'
} %}

{% for cat_nombre in orden_categorias %}
    {% if cat_nombre in equipamientos_agrupados.general and equipamientos_agrupados.general[cat_nombre]|length > 0 %}
        {% set lista = equipamientos_agrupados.general[cat_nombre] %}
        <details class="card-accordion">
            <summary class="acc-header">
                <i data-lucide="chevron-right" class="acc-chevron"></i>
                <div class="acc-title-box">
                    <i data-lucide="{{ iconos_cat[cat_nombre] if cat_nombre in iconos_cat else 'help-circle' }}" class="acc-icon"></i>
                    <span>{{ cat_nombre }}</span>
                    <span class="acc-badge">({{ lista|length }} registros)</span>
                </div>
            </summary>
            
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="col-foto">Foto</th>
                            <th class="col-mapa">Ubicación</th>
                            <th class="col-deno">Denominación</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-obs">Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for eq in lista %}
                        <tr class="fila-equip" data-id="{{ eq.cod }}">
                            <td class="td-foto">
                                <div style="width: 52px; height: 40px; margin: 0 auto; position: relative; display: flex; align-items: center; justify-content: center;">
                                    {% if eq.url_foto %}
                                        <img src="{{ eq.url_foto }}" 
                                             class="img-thumb" 
                                             alt="Foto"
                                             onclick="abrirVisorImagen(this.src)"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                        
                                        {# Este solo se activa si la imagen de arriba falla #}
                                        <div class="no-photo-placeholder" style="display: none;" title="Error al cargar desde el servidor de mapas. Verifique su conexión o firewall.">
                                            <i data-lucide="camera-off" style="width: 16px;"></i>
                                        </div>
                                    {% else %}
                                        {# Caso normal: No hay foto #}
                                        <div class="no-photo-placeholder">
                                            <i data-lucide="camera-off" style="width: 16px;"></i>
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="td-ubicacion">
                                <a href="{{ eq.url_visor }}" target="_blank" class="btn btn-secondary btn-sm">
                                    <i data-lucide="map-pin"></i><span>Mapa</span>
                                </a>
                            </td>
                            <td>
                                <div class="nombre-eq"><strong>{{ eq.nombre }}</strong></div> <small class="cod-eq">Cód: {{ eq.cod }}</small>
                            </td>
                            <td>
                                <div class="estado-wrapper">
                                    <span class="status-dot dot-{{ eq.estado_txt.lower().replace(' ', '').replace('ó', 'o') }}"></span>
                                    <select class="form-select select-estado" data-id="{{ eq.cod }}" data-original="{{ eq.estado_txt }}">
                                        <option value="Bueno" {% if eq.estado_txt == 'Bueno' %}selected{% endif %}>Bueno</option>
                                        <option value="Regular" {% if eq.estado_txt == 'Regular' %}selected{% endif %}>Regular</option>
                                        <option value="Malo" {% if eq.estado_txt == 'Malo' %}selected{% endif %}>Malo</option>
                                        <option value="En ejecución" {% if eq.estado_txt == 'En ejecución' %}selected{% endif %}>En ejecución</option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <textarea class="form-input txt-obs-eq" rows="1" placeholder="..."></textarea>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </details>
    {% endif %}
{% endfor %}

{# --- SECCIÓN: EDIFICIOS PÚBLICOS SIN USO --- #}
{% if equipamientos_agrupados.sin_uso|length > 0 %}
<details class="card-accordion">
    <summary class="acc-header">
        <i data-lucide="chevron-right" class="acc-chevron"></i>
        <div class="acc-title-box">
            <i data-lucide="door-closed" class="acc-icon"></i>
            <span>EDIFICIOS PÚBLICOS SIN USO</span>
            <span class="acc-badge">({{ equipamientos_agrupados.sin_uso|length }} registros)</span>
        </div>
    </summary>

    <div class="table-wrapper">
        <p class="sin-uso-intro">Indique si estos edificios han pasado a tener un uso concreto o si continúan cerrados.</p>
        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-foto">Foto</th>
                    <th class="col-mapa">Ubicación</th>
                    <th class="col-deno">Denominación</th>
                    <th class="col-obs">¿Tiene uso?</th>
                </tr>
            </thead>
            <tbody>
                {% for su in equipamientos_agrupados.sin_uso %}
                <tr class="fila-sin-uso" data-id="{{ su.cod }}">
                    <td class="td-foto">
                        <div style="width: 52px; height: 40px; margin: 0 auto; position: relative; display: flex; align-items: center; justify-content: center;">
                            {% if su.url_foto %}
                                <img src="{{ su.url_foto }}" 
                                     class="img-thumb" 
                                     alt="Foto"
                                     onclick="abrirVisorImagen(this.src)"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                
                                {# Este solo se activa si la imagen de arriba falla #}
                                <div class="no-photo-placeholder" style="display: none;">
                                    <i data-lucide="camera-off" style="width: 16px;"></i>
                                </div>
                            {% else %}
                                {# Caso normal: No hay foto #}
                                <div class="no-photo-placeholder">
                                    <i data-lucide="camera-off" style="width: 16px;"></i>
                                </div>
                            {% endif %}
                        </div>
                    </td>

                                        <td class="td-ubicacion">
                        <a href="{{ su.url_visor }}" target="_blank" class="btn btn-secondary btn-sm"><i data-lucide="map-pin"></i><span>Mapa</span></a>
                    </td>
                    <td>
                        <div class="nombre-eq"><strong>{{ su.nombre }}</strong></div>
                        <small class="cod-eq">Cód: {{ su.cod }}</small>
                    </td>
                    <td>
                        <div class="uso-container">
                            <select class="form-select select-sin-uso" data-id="{{ su.cod }}" 
                                    onchange="const box = document.getElementById('box_uso_{{su.cod}}'); this.value === 'SI' ? box.classList.remove('hidden') : box.classList.add('hidden')">
                                <option value="NO">NO, sigue sin uso</option>
                                <option value="SI">SÍ, ya tiene uso</option>
                            </select>
                            <div id="box_uso_{{su.cod}}" class="hidden" style="margin-top: 8px;">
                                <input type="text" class="form-input txt-nuevo-uso" placeholder="Indique el nuevo uso...">
                            </div>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</details>
{% endif %}

{# --- SECCIÓN: NUEVOS EQUIPAMIENTOS --- #}
<div class="card" id="cardNuevos"">
    <h2 class="section-title"><i data-lucide="list-plus"></i>Notificar Nuevo Equipamiento</h2>
    <p class="form-help" style="margin-bottom: 1.5rem;">Use esta sección para dar de alta edificios o instalaciones que no aparecen en el listado superior.</p>
    
    <div class="table-wrapper" style="background: white; border-radius: 8px; border: 1px solid #e2e8f0;">
        <table class="data-table" id="tablaNuevos">
            <thead>
                <tr>
                    <th style="width: 30%;">DENOMINACIÓN / UBICACIÓN</th>
                    <th style="width: 32%;">USO(S) / ESTADO</th>
                    <th style="width: 22%;">OBSERVACIONES</th>
                    <th style="width: 15%; text-align: center;">FOTO / DOC.</th>
                    <th style="width: 5%; text-align: center;"></th>
                </tr>
            </thead>
            <tbody id="tbodyNuevos">
                </tbody>
        </table>
    </div>

    <div style="margin-top: 1rem;">
        <button type="button" class="btn btn-secondary btn-sm" onclick="agregarFilaNuevoEquipamiento()" style="background: white; width: auto;">
            <i data-lucide="plus"></i> Añadir otro equipamiento
        </button>
    </div>
</div>

{# --- SECCIÓN: REQUERIMIENTOS --- #}
{% if avisos_personalizados and avisos_personalizados|length > 0 %}
<div class="card card-requerimientos">
    <div class="requerimientos-content">
        <h2 class="section-title">
            <i data-lucide="circle-plus"></i> Otra información solicitada
        </h2>
        
        <p class="form-help form-help-spacer">
            Se ha detectado falta de información o incidencias en la EIEL que requieren solución. Responda a cada punto y adjunte documentación si es necesario.
        </p>

        <ul class="requerimientos-list" style="list-style: none; padding: 0;">
            {% for aviso in avisos_personalizados %}
            {% set req_id = loop.index0 %}
            <li class="aviso-item" style="display: flex; flex-direction: column; align-items: stretch; gap: 10px; padding: 15px; border-bottom: 1px dashed #e2e8f0;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div class="status-dot {{ 'dot-alta' if aviso.prioridad == 'Alta' else 'dot-media' }}"></div>
                        <span style="font-weight: 600; color: var(--text-primary); font-size: 0.95rem;">{{ aviso.mensaje }}</span>
                    </div>
                    
                    {% if aviso.url %}
                        {% set final_url = aviso.url if 'http' in aviso.url else 'https://' ~ aviso.url %}
                        <a href="{{ final_url }}" target="_blank" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; gap: 5px; text-decoration: none; background: white; border: 1px solid #cbd5e1;">
                            <i data-lucide="map" style="width: 14px; height: 14px;"></i> Mapa
                        </a>
                    {% endif %}
                </div>
                
                <div style="margin-left: 28px; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <textarea class="form-input txt-resp-req" data-msg="{{ aviso.mensaje }}" data-id="{{ req_id }}" rows="2" 
                              placeholder="Responda o aclare este punto aquí..." style="margin-bottom: 8px; background: white;"></textarea>
                    
                    <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 10px;">
                        <button type="button" class="btn btn-secondary btn-sm" 
                                onclick="gestionarAdjuntosReq('{{ req_id }}')" 
                                title="Adjuntar documentación">
                            <i data-lucide="paperclip"></i> Adjuntar
                        </button>
                        <div style="font-size: 0.65rem; color: #94a3b8; margin-top: 2px; white-space: nowrap; font-weight: 500;">
                            Máx 35 MB / archivo
                        </div>
                        <div id="lista_adjuntos_req_{{ req_id }}" class="file-list-container" style="margin: 0; display: flex; flex-direction: column; gap: 4px; width: 100%;"></div>
                    </div>
                </div>
            </li>
            {% endfor %}
        </ul>
        <input type="file" id="hiddenInputReq" multiple style="display: none;">
    </div>
</div>
{% endif %}

{# --- SECCIÓN: OBSERVACIONES --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="file-text"></i>Observaciones</h2>
    <div class="form-group">
        <label for="observaciones" class="form-label">Comentarios adicionales:</label>
        <textarea id="observaciones" class="form-input" rows="4" placeholder="Indique aquí cualquier incidencia, aclaración o dato relevante..."></textarea>
    </div>
</div>

{# --- SECCIÓN: ADJUNTOS --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="folder"></i>Documentación Adjunta (Opcional)</h2>    
    <div class="file-upload-area" onclick="document.getElementById('fileInput').click()">
        <div class="upload-icon">
            <i data-lucide="upload-cloud" style="width: 40px; height: 40px; margin-bottom: 10px; opacity: 0.7;"></i>
        </div>
        <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-primary);">
            Arrastra y suelta archivos aquí
        </div>
        <div style="font-size: 0.9rem; color: var(--text-secondary); margin: 5px 0;">
            o <span style="text-decoration: underline; color: var(--primary); cursor: pointer;">haz clic para buscarlos</span>
        </div>
        <p class="upload-help" style="margin-top: 8px;">(Planos, fotos, informes, análisis... Máx 35 MB / archivo)</p>
        <input type="file" id="fileInput" multiple style="display: none;">
    </div>
    <div id="fileList" class="file-list-container"></div>
</div>

{# --- SECCIÓN: DATOS DE CONTACTO --- #}
<div class="card">
    <h2 class="section-title"><i data-lucide="user"></i>Datos de Contacto</h2>
    <div class="grid-2-col">
        <div class="form-group">
            <label class="form-label">Nombre y apellidos *</label>
            <input type="text" id="contactoNombre" class="form-input" placeholder="Ej: Juan Pérez" required>
        </div>
        <div class="form-group">
            <label class="form-label">Departamento</label>
            <input type="text" id="contactoDepartamento" class="form-input" placeholder="Ej: Urbanismo" required>
        </div>
       <div class="form-group">
            <label class="form-label">Email (Para recibir justificante) *</label>
            <input type="email" id="contactoEmail" class="form-input" placeholder="Ej: ejemplo@ayuntamiento.es" required>
        </div>
        
        <div class="form-group">
            <label class="form-label">Confirme su Email *</label>
            <input type="email" id="contactoEmailConfirm" class="form-input" placeholder="Repita el email" required onpaste="return false;">
            </div>
    </div>
</div>

{# --- SECCIÓN: DECLARACIÓN RESPONSABLE --- #}
<div class="card">
    <div class="conformidad-box">
        <label class="check-label">
            <input type="checkbox" id="checkConformidad" class="check-input">
            <span class="check-text">
                <strong>Declaración de veracidad:</strong> Como responsable, 
                confirmo que los datos introducidos son correctos y actualizados.
            </span>
        </label>
    </div>

{# --- SECCIÓN: ENVÍO --- #}
    <div id="mensaje" class="message hidden"></div>
    
    <button id="btnEnviar" class="btn btn-primary" disabled>
        Enviar Datos
    </button>
</div>

<input type="file" id="hiddenInputNuevos" multiple style="display: none;">

{% endblock %}

{% block scripts %}
<script>
document.addEventListener("DOMContentLoaded", () => {
    document.body.classList.add('theme-equipamientos');
    if (window.lucide) lucide.createIcons();

    EIEL.applyHeaderTheme('equipamientos');
    EIEL.mergeConfig({
        muniCode: "{{ muni_code }}",
        muniName: "{{ muni_display }}",
        fase: "{{ fase_actual }}",
        urlGenerarPdf: "{{ url_generar_pdf }}",
        urlAdjuntos: "{{ url_adjuntos }}",
        urlLogger: "{{ url_logger }}",
        hasAvisos: {{ 'true' if (avisos_personalizados and avisos_personalizados|length > 0) else 'false' }},
        yearActual: new Date().getFullYear()
    });

    EIEL.setupSelectHasValue();

    document.querySelectorAll('.select-estado').forEach(sel => {
        sel.addEventListener('change', function() {
            const dot = this.parentNode.querySelector('.status-dot');
            if (dot) {
                dot.className = 'status-dot';
                const classValue = this.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s/g, "");
                dot.classList.add('dot-' + classValue);
            }
        });
    });

    const UIProgress = EIEL.UIProgress;
    const archivosMgr = EIEL.createGeneralFileManager({
        useAddEventListener: true,
        markDirtyOnDrop: false,
        clearEmptyList: false
    });
    const reqMgr = EIEL.createReqAttachmentManager({ variant: 'equipamientos' });

    let colaAdjuntosNuevos = {};
    let filaActualAdjuntos = null;
    let contadorNuevosEq = 0;
    const inputNuevos = document.getElementById('hiddenInputNuevos');

    window.agregarFilaNuevoEquipamiento = () => {
        formSucio = true;
        contadorNuevosEq++;
        const idFila = `NUEVO_EQ_${contadorNuevosEq}`;
        const tbody = document.getElementById('tbodyNuevos');
        const tr = document.createElement('tr');
        tr.id = `fila_${idFila}`;
        tr.className = 'fila-nuevo-eq';

        tr.innerHTML = `
            <td style="vertical-align: top; padding: 12px 8px;">
                <input type="text" class="form-input new-deno" placeholder="Ej: Edificio Polivalente" style="display: block; margin-bottom: 8px;">
                <input type="text" class="form-input new-ubica" placeholder="Dirección, ref. catastral o coords." style="display: block;">
            </td>
            <td style="vertical-align: top; padding: 12px 8px;">
                <input type="text" class="form-input new-uso" placeholder="Ej: PB Biblioteca / P1 Asociaciones" style="display: block; margin-bottom: 8px;">
                <select class="form-select new-estado" style="display: block;">
                    <option value="">Seleccionar...</option>
                    <option value="Bueno">Bueno</option>
                    <option value="Regular">Regular</option>
                    <option value="Malo">Malo</option>
                    <option value="En ejecución">En ejecución</option>
                </select>
            </td>
            <td style="vertical-align: top; padding: 12px 8px;">
                <textarea class="form-input new-obs-fila" placeholder="Observaciones adicionales..." style="display: block; width: 100%; min-height: 88px;"></textarea>
            </td>
            <td style="vertical-align: top; text-align: center; padding: 12px 8px;">
                <div style="display: flex; flex-direction: column; align-items: center;">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="gestionarAdjuntosFila('${idFila}')" title="Adjuntar documentación">
                        <i data-lucide="paperclip"></i> Adjuntar
                    </button>
                    <div style="font-size: 0.65rem; color: #94a3b8; margin-top: 4px; white-space: nowrap; font-weight: 500;">Máx 35 MB / archivo</div>
                </div>
                <div id="lista_adjuntos_${idFila}" class="file-list-container" style="margin-top: 8px;"></div>
            </td>
            <td style="vertical-align: top; text-align: center; padding: 12px 8px;">
                <button type="button" class="btn-danger-icon" onclick="eliminarFilaNuevoEq('${idFila}')" title="Eliminar fila" style="border:none; background:none; padding: 4px; cursor: pointer;">
                    <i data-lucide="trash-2" style="width:18px; color: #ef4444;"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);

        const nuevoSelect = tr.querySelector('.new-estado');
        if (nuevoSelect) {
            nuevoSelect.addEventListener('change', () => {
                if (nuevoSelect.value === "") nuevoSelect.classList.remove('has-value');
                else nuevoSelect.classList.add('has-value');
            });
        }
        if (window.lucide) lucide.createIcons();
    };

    window.gestionarAdjuntosFila = (idFila) => {
        filaActualAdjuntos = idFila;
        if (inputNuevos) inputNuevos.click();
    };

    if (inputNuevos) {
        inputNuevos.addEventListener('change', () => {
            formSucio = true;
            const files = Array.from(inputNuevos.files);
            if (!files.length || !filaActualAdjuntos) return;
            const validos = EIEL.filterFilesBySize(files);
            if (validos.length > 0) {
                if (!colaAdjuntosNuevos[filaActualAdjuntos]) colaAdjuntosNuevos[filaActualAdjuntos] = [];
                colaAdjuntosNuevos[filaActualAdjuntos].push(...validos);
                renderFilaAdjuntos(filaActualAdjuntos);
            }
            inputNuevos.value = "";
            filaActualAdjuntos = null;
        });
    }

    function renderFilaAdjuntos(idFila) {
        const contenedor = document.getElementById(`lista_adjuntos_${idFila}`);
        if (!contenedor) return;
        contenedor.innerHTML = (colaAdjuntosNuevos[idFila] || []).map((f, i) => `
            <div class="file-item" style="font-size:0.7rem; border:1px solid #e2e8f0; margin-bottom:2px; padding:2px; border-radius:4px; display:flex; justify-content:space-between; align-items:center;">
                <span title="${f.name}"><i data-lucide="paperclip" style="width:10px;"></i> ${f.name.substring(0,12)}...</span>
                <button type="button" onclick="eliminarArchivoDeFila('${idFila}', ${i})" class="btn-danger-icon">
                    <i data-lucide="trash-2" style="width:12px;"></i>
                </button>
            </div>
        `).join("");
        if (window.lucide) lucide.createIcons();
    }

    window.eliminarArchivoDeFila = (idFila, index) => {
        formSucio = true;
        colaAdjuntosNuevos[idFila].splice(index, 1);
        renderFilaAdjuntos(idFila);
    };

    window.eliminarFilaNuevoEq = (idFila) => {
        formSucio = true;
        const fila = document.getElementById(`fila_${idFila}`);
        if (fila) fila.remove();
        delete colaAdjuntosNuevos[idFila];
    };

    EIEL.setupConformidad();

    if (typeof agregarFilaNuevoEquipamiento === 'function') {
        agregarFilaNuevoEquipamiento();
    }

    const btnEnviar = document.getElementById("btnEnviar");
    if (!btnEnviar) return;

    btnEnviar.addEventListener("click", async () => {
        const idBatch = EIEL.newBatchId();
        EIEL.hideMensaje();

        const contact = EIEL.validateContact();
        if (!contact.ok) { EIEL.mostrarMensaje(contact.message, "error"); return; }

        const oversized = EIEL.findOversizedFile([
            archivosMgr.getFiles(),
            reqMgr.getCola(),
            colaAdjuntosNuevos
        ]);
        if (oversized) {
            EIEL.mostrarMensaje(`⚠️ El archivo "${oversized.name}" excede los 35 MB permitidos. Por favor, optimícelo antes de enviar.`, "error");
            toggleFormFreeze(false);
            return;
        }

        const req = EIEL.validateRequerimientos(reqMgr.getCola(), {
            message: "⚠️ Debe dar una respuesta individualizada (texto o adjunto) a cada uno de los requerimientos del apartado «Otra Información Solicitada»."
        });
        if (!req.ok) { EIEL.mostrarMensaje(req.message, "error"); return; }

        formSucio = false;
        toggleFormFreeze(true);

        // Paridad: orden GENERAL → REQUERIMIENTOS → NUEVOS
        const listaTareas = [];
        archivosMgr.getFiles().forEach(file => listaTareas.push({ file, seccion: 'GENERAL' }));
        Object.entries(reqMgr.getCola()).forEach(([id, listado]) => {
            const numReq = parseInt(id, 10) + 1;
            listado.forEach(file => listaTareas.push({ file, seccion: `REQUERIMIENTO_${numReq}` }));
        });
        Object.entries(colaAdjuntosNuevos).forEach(([id, listado]) => {
            listado.forEach(file => listaTareas.push({ file, seccion: id }));
        });

        const totalTasks = listaTareas.length;
        UIProgress.show(totalTasks);
        UIProgress.update(0, totalTasks, "Iniciando el envío...");

        try {
            const completados = await EIEL.uploadTaskList(listaTareas, idBatch, { defaultTipo: 'equipamientos' });
            UIProgress.update(completados, totalTasks, "Procesando datos y generando justificante...");

            const datosEquipamientos = Array.from(document.querySelectorAll('.fila-equip')).map(tr => {
                const select = tr.querySelector('.select-estado');
                return {
                    id: tr.dataset.id,
                    nombre: tr.querySelector('.nombre-eq strong').textContent,
                    categoria: tr.closest('details').querySelector('.acc-title-box span').textContent,
                    estado: select.value,
                    modificado: select.value !== select.dataset.original,
                    obs: tr.querySelector('.txt-obs-eq').value.trim()
                };
            });

            const datosSinUso = Array.from(document.querySelectorAll('.fila-sin-uso')).map(tr => ({
                id: tr.dataset.id,
                nombre: tr.querySelector('.nombre-eq strong').textContent,
                tiene_uso: tr.querySelector('.select-sin-uso').value,
                nuevo_uso: tr.querySelector('.txt-nuevo-uso').value.trim()
            }));

            const dataNuevos = Array.from(document.querySelectorAll('.fila-nuevo-eq')).map(fila => {
                const idFila = fila.id.replace('fila_', '');
                return {
                    nombre: fila.querySelector('.new-deno').value.trim(),
                    direccion: fila.querySelector('.new-ubica').value.trim(),
                    uso: fila.querySelector('.new-uso').value.trim(),
                    estado: fila.querySelector('.new-estado').value,
                    observaciones: fila.querySelector('.new-obs-fila').value.trim(),
                    archivo: (colaAdjuntosNuevos[idFila] || []).map(f => f.name).join("; ")
                };
            });

            const payload = EIEL.buildBasePayload({
                idBatch,
                nombre: contact.nombre,
                email: contact.email,
                departamento: contact.departamento,
                extra: {
                    tipo_formulario: "equipamientos",
                    observaciones: document.getElementById("observaciones").value.trim(),
                    archivos_adjuntos: listaTareas.map(t => t.file.name).join("\n"),
                    datos_equipamientos_json: JSON.stringify(datosEquipamientos),
                    edificios_sin_uso_json: JSON.stringify(datosSinUso),
                    nuevos_equipamientos_json: JSON.stringify(dataNuevos),
                    respuestas_requerimientos_json: JSON.stringify(req.respuestas)
                }
            });

            await EIEL.sendPdfPayload(payload);
            UIProgress.complete();

            archivosMgr.clear();
            reqMgr.clear();
            colaAdjuntosNuevos = {};
            EIEL.resetFormAfterSuccess();
        } catch (error) {
            console.error(error);
            EIEL.mostrarMensaje(`❌ Error técnico: ${error.message}`, "error");
            toggleFormFreeze(false);
        }
    });
});
</script>
{% endblock %}
